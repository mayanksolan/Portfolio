---
import Layout from '../layouts/Layout.astro';
import { aboutCards, site } from '../data/resume';

const base = import.meta.env.BASE_URL;
---

<Layout title="About | Mayank Solan" description="About Mayank Solan, a senior frontend-focused developer with a background in ETL, SQL systems, and product execution.">
  <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-[#f5f0ea]/80 backdrop-blur-sm">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5 sm:px-6 lg:px-8">
      <a href={base} class="text-sm font-extrabold uppercase tracking-[0.18em] text-slate-800">Mayank Solan</a>
      <nav class="flex items-center gap-6 text-sm text-slate-600" aria-label="Main navigation">
        <a href={base} class="hover:text-slate-900">Home</a>
        <a href={`${base}work`} class="hover:text-slate-900">Work</a>
        <a href={`${base}about`} class="hover:text-slate-900">About</a>
        <a href={`${base}contact`} class="hover:text-slate-900">Contact</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-[#b78d6a]">About</p>
    <h1 class="max-w-4xl text-4xl font-black tracking-[-0.06em] text-slate-900 sm:text-5xl lg:text-6xl">
      Senior frontend engineer with product sense, backend awareness, and experience across data-heavy systems.
    </h1>
    <p class="mt-5 max-w-3xl text-lg text-slate-600">
      I’ve built scalable frontend products for analytics, fundraising, and community platforms, while also working in data and BI-heavy environments where SQL, product workflows, and high-quality execution mattered equally.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {aboutCards.map((item) => (
        <article class="rounded-[24px] border border-slate-200 bg-white/50 p-6 shadow-sm">
          <h2 class="mb-3 text-2xl font-bold text-slate-900">{item.title}</h2>
          <p class="text-slate-600">{item.summary}</p>
        </article>
      ))}
    </div>
  </main>

  <footer class="border-t border-slate-200 bg-white/20">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-7 text-sm text-slate-600 sm:px-6 lg:px-8">
      <p>Mayank Solan</p>
      <a href={`mailto:${site.email}`} class="font-medium text-slate-800">{site.email}</a>
    </div>
  </footer>
</Layout>
